# 复制为 config/env.sh。密码含单引号时请用正确的 Shell 转义。
export ADMIN_USER='admin'
export ADMIN_PASSWORD='GENERATE_ADMIN_PASSWORD'
export FEATURE_KEY='GENERATE_FEATURE_KEY'
export LOCAL_DB_PASSWORD='GENERATE_LOCAL_PASSWORD'
export DEVICE_ID='terminal-001'
export PUNCH_TYPE='PUNCH'
export CLOUD_ENABLED='true'
export CLOUD_DB_URL='jdbc:mysql://your-cloud-db.example.com:3306/face_attendance?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&sslMode=VERIFY_IDENTITY&connectTimeout=3000&socketTimeout=5000'
export CLOUD_DB_USER='face_terminal'
export CLOUD_DB_PASSWORD='REPLACE_CLOUD_PASSWORD'
export CAMERA_INDEX='0'
export CAMERA_BACKEND='auto'
export SERVER_ADDRESS='127.0.0.1'
export SERVER_PORT='8080'
export THIRD_PARTY_ENABLED='false'
export THIRD_PARTY_URL='https://your-attendance.example.com/api/punch'
export THIRD_PARTY_TOKEN=''
export THIRD_PARTY_SUCCESS_FIELD='success'
export THIRD_PARTY_SUCCESS_VALUE='true'
# 嵌套业务状态可以用 JSON Pointer，如 /data/code；成功值如 0。
# 其他字段映射请参见 application.yml 与 README。
